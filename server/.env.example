# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dbtasks
DB_USER=dbtasks
DB_PASSWORD=change-me

# API service
PORT=4000
# Comma-separated list of allowed browser origins, or * for any
CORS_ORIGIN=*

# Notifications via ntfy (optional — see SELF_HOSTING.md)
# NTFY_URL=https://ntfy.sh/your-unguessable-topic-name
# NTFY_ENABLED=true
# NTFY_TOKEN=                # only if your ntfy server requires auth
# NTFY_DIGEST_AT=08:00       # local-time morning digest
# NTFY_ESCALATE_AT=          # optional afternoon overdue nudge, e.g. 15:00
# NTFY_TZ_OFFSET=+10:00      # your timezone offset from UTC
